# Copy to .env and change for your deployment
PORT=3000
# Admin dashboard password (default: detective2026). CHANGE THIS before a real study.
ADMIN_PASSWORD=detective2026
# Secret used to sign admin tokens (any long random string)
ADMIN_SECRET=change-me-to-a-long-random-string
# Database: leave DATABASE_URL unset to use local SQLite (zero setup).
# Set it (Supabase pooler connection string) to use Postgres, e.g. on Vercel:
# DATABASE_URL=postgresql://USER.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
# Optional explicit override: DB_DRIVER=sqlite | postgres
# SQLite file (relative to server/). Default: data/phishing-detective.db
DB_FILE=data/phishing-detective.db
