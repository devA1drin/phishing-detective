# Copy to .env and change for your deployment
PORT=3000
# Secret used to sign player/admin tokens (any long random string). REQUIRED in production.
APP_SECRET=change-me-to-a-long-random-string
# First-run superadmin: created only when the admins table is empty.
# There is NO default password: without SUPERADMIN_PASSWORD the admin dashboard stays disabled.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
# Rate limiting (on by default). Set RATE_LIMIT=off only for local load tests.
# RATE_LIMIT=off
# Database: leave DATABASE_URL unset to use local SQLite (zero setup).
# Set it (Supabase pooler connection string) to use Postgres, e.g. on Vercel:
# DATABASE_URL=postgresql://USER.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
# Optional explicit override: DB_DRIVER=sqlite | postgres
# SQLite file (relative to server/). Default: data/phishing-detective.db
DB_FILE=data/phishing-detective.db

# Optional AI features (scenario generator + AI coach) via Vercel AI Gateway.
# Without a key (and outside Vercel) AI is off: players get static coach tips.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-5.4-mini
# AI_ENABLED=false
# Base URL printed on certificates (defaults to the request host)
# PUBLIC_URL=https://phishing-detective-mu.vercel.app
